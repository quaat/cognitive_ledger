{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "python3 scripts/agent-hooks/pre-command.py"}]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{"type": "command", "command": "python3 scripts/agent-hooks/protect-secrets.py"}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "./scripts/check-fast.sh sanity", "timeout": 30}]
      }
    ]
  }
}
